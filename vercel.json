{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/elevation/profile",
      "destination": "/api/osm/stations?resource=elevation"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/evrace-refresh",
      "schedule": "0 3 * * *"
    }
  ]
}
